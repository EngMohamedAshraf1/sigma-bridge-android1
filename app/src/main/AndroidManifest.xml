<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Phase 7 adds exactly what a Foreground Service needs to run and show its
         mandatory notification: FOREGROUND_SERVICE (+ the DATA_SYNC subtype required
         on API 34+) and POST_NOTIFICATIONS (API 33+, or the notification is silently
         hidden). RECEIVE_BOOT_COMPLETED and any battery-optimization-exemption intent
         are still NOT here — those are Phase 8, not this one. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SigmaBridgeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.SigmaBridge"
        android:supportsRtl="true">

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SigmaBridge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Orchestration only: starts/stops BridgeOrchestrator and shows the
             mandatory foreground notification. No boot-time auto-start (no
             BOOT_COMPLETED receiver registered anywhere), per Phase 7 scope. -->
        <service
            android:name=".service.BridgeForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
