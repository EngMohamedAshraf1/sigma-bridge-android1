<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only INTERNET is needed for Phase 1 (empty UI shell, no networking yet). -->
    <!-- FOREGROUND_SERVICE, POST_NOTIFICATIONS, RECEIVE_BOOT_COMPLETED, and the -->
    <!-- battery-optimization-exemption intent are added in Phase 7/8, not before, -->
    <!-- so the manifest only ever asks for what the current phase actually uses. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".SigmaBridgeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.SigmaBridge"
        android:supportsRtl="true">

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SigmaBridge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
