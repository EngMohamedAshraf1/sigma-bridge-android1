<?xml version="1.0" encoding="utf-8"?>
<!--
  Excludes the encrypted credentials file from Auto Backup and device-to-device
  transfer. The Keystore key backing EncryptedSharedPreferences does not
  migrate with a backup, so a restored copy of the encrypted file would be
  undecryptable garbage anyway — better to exclude it outright than ship a
  broken restore, and it avoids the encrypted blob ever leaving the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sigma_bridge_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sigma_bridge_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
